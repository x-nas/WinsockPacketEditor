<Project Sdk="Microsoft.NET.Sdk">

  <!--
    钩子 / 滤镜引擎的回归跑测（IPC 改造的验证矩阵第 1、3、4、5、8、9、11 项）。

    它把钩子装在<b>自己这个进程</b>里（LocalHook 本来就是进程内的），
    因此不需要真的注入一个游戏就能逐个验 13 个 WinSock 入口、四种滤镜动作、
    以及 IHookHost 这条接缝 —— 每个阶段改完跑一次，输出可以逐字对比。

    ⚠️ 位数必须与主工程一致（AnyCPU + Prefer32Bit=false），
    否则 SQLite.Interop 的位数对不上，这个坑 WPEHybrid 已经踩过一次。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WPEHookTest</AssemblyName>
    <RootNamespace>WPEHookTest</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinsockPacketEditor\WinsockPacketEditor.csproj" />
    <!-- 注入要用 WPEHook.dll：ShellLink 按「主程序所在目录 + WPE64_DLL」找它，
         不引这一条的话跑测的输出目录里没有这个文件，注入直接失败 -->
    <ProjectReference Include="..\WPEHook\WPEHook.csproj" />
    <!-- 32 位靶子：验证矩阵要求每一项在两种位数上各跑一遍。
         ReferenceOutputAssembly=false —— 只要它<b>编出来并落到同一个目录</b>，
         不能真的引用它（那是个 x86 的 exe，引进来位数就冲突了）。 -->
    <ProjectReference Include="..\WPETarget32\WPETarget32.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 主工程的 Operate 有一部分签名用了 Span<byte>，net48 下必须显式引这个包（版本与主工程对齐） -->
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <!--
    把 32 位靶子拷进跑测的输出目录。

    ProjectReference 带了 ReferenceOutputAssembly=false，所以 MSBuild
    只保证它<b>先编</b>、不会把产物拷过来 —— 得自己拷。
    （不能改成普通引用：那是个 x86 的 exe，引进来位数就冲突了。）
  -->
  <Target Name="CopyTarget32" AfterTargets="Build">
    <ItemGroup>
      <Target32Files Include="..\WPETarget32\bin\$(Configuration)\net48\WPETarget32.*" />
    </ItemGroup>
    <Copy SourceFiles="@(Target32Files)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
