<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPE x64 的产品工程：单一 WinsockPacketEditor.exe（WebView2 外壳 + Vue 前端 + 全部业务逻辑）。

    2026-09-11 从老式工程（packages.config + 逐个 Compile Include）升级成 SDK 式，目标框架仍是 net48。
    收益：.cs 自动包含（不必再「补 Compile Include」）、PackageReference（WebView2 的原生 loader
    由包自带的 targets 按 runtimes\win-*\native\ 布局拷，不用手工列）、工程文件从 400 行缩到这些。

    入口是原外壳的 Program.Main（命名空间仍是 WPEHybrid，只是并进同一个程序集）。
    前端源在 WebUI\（Vite 工程，与管理台 Web\ 在 Windows 上大小写撞名才改的名），产物在 wwwroot\。

    ⚠️ 构建请从解决方案走，并带上还原：
       MSBuild.exe WinSockPacketEditor.sln -restore -p:Configuration=Debug
    WPEHook 引用本工程（方向是反的），本工程不能 ProjectReference 它，
    WPEHook.dll 靠它自己的 post-build 拷进这里的 bin\<配置>\ —— 只编本工程不会带上它。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WinsockPacketEditor</RootNamespace>
    <AssemblyName>WinsockPacketEditor</AssemblyName>
    <ProjectGuid>{B5ED16ED-ABD5-438B-A589-E8ACC2377432}</ProjectGuid>
    <StartupObject>WPEHybrid.Program</StartupObject>
    <!-- 与老式工程一致：C# 7.3（代码里有几处写法按 7.3 的限制取舍过，见 CLAUDE.md 的 HexToBytes） -->
    <LangVersion>7.3</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      必须显式写死：SDK 会给 net48 的 exe 默认 PlatformTarget=x86（_UsingDefaultPlatformTarget），
      那样产品被编成 32 位进程 —— SQLite.Interop / SunnyNet 的原生 DLL 位数对不上，
      WebView2 的 targets 也只拷 x86 那一份 loader。置成 AnyCPU 才走 IsManagedPlatformAnyCpu 那支，三种架构都拷。
    -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!--
      输出仍是 bin\<配置>\，不要 net48 子目录：WPEHook 的 post-build、反射跑测（tools\tests）、
      发布打包（WinRAR 打 bin\Release\）、文档都按这个路径写的。
    -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 版本号等在 Properties\AssemblyInfo.cs 里手写，别让 SDK 再生成一份（会报重复特性） -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <!-- 清单声明 requireAdministrator + PerMonitorV2（2026-09-13 起；Program.Main 的 RestartAsAdmin 只是兜底） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>wpe.ico</ApplicationIcon>
    <!-- binding redirects 自动生成到 .exe.config（靠 App.config 打底） -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <!-- WebView2 包同时含 WinForms/WPF 两套，压掉 WPF 引入的版本冲突噪声 -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <!--
      默认通配（**\*）要排掉前端的依赖目录：node_modules 有上万个文件，吞进工程会拖慢每次加载。
      WebUI\ 下的源码仍然可见。
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);WebUI\node_modules\**;WebUI\dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- 调试信息的格式照老式工程：Debug 用 full、Release 用 pdbonly -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK 的隐式框架引用之外，本工程还用到的这几个 -->
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!--
    NuGet 包：与原 packages.config 逐条一一对应（连 packages.config 里平铺出来的传递依赖一起
    显式列出，把版本钉死，不让还原按依赖范围自己挑）。

    2026-09-11 升过一轮：Microsoft.Owin 全家 4.2.2 → 4.2.3（加固 cookie 解析）、WebView2 SDK 1.0.4129.50 → 1.0.4191.47、
    log4net 的钉 2.0.3 → 3.4.0（见下）。⚠️ SuperSocket 刻意停在 1.6.6.1：2.x 只有 net6+ 目标，没有 net48，
    见 CLAUDE.md「为什么不用 .NET 8」。
  -->
  <ItemGroup>
    <!-- EasyHook 自带的原生件（EasyHook32/64 + Svc + EasyLoad）走下面工程目录里那六份，不用包里的 contentFiles —— 两份字节相同，
         用工程里的那份是为了让 WPEHookTest 经 ProjectReference 也拿得到（包的 contentFiles 不向引用方传递）。 -->
    <PackageReference Include="EasyHook" Version="2.7.7097" ExcludeAssets="contentFiles" />
    <PackageReference Include="InputSimulator" Version="1.0.4.0" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" Version="5.3.0" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Owin" Version="5.3.0" />
    <PackageReference Include="Microsoft.AspNet.WebApi.OwinSelfHost" Version="5.3.0" />
    <PackageReference Include="Microsoft.Owin" Version="4.2.3" />
    <PackageReference Include="Microsoft.Owin.FileSystems" Version="4.2.3" />
    <!--
      ⚠️ Microsoft.Owin.Host.HttpListener 与 SuperSocket.Engine 里的 SuperSocket.SocketEngine 都是<b>运行期</b>按名字加载的
      （WebApp.Start 按约定探测宿主程序集；AppServerBase.SetupBasic 里 Type.GetType("SuperSocket.SocketEngine…")），
      编译期没有任何引用。本工程直接引用这两个包，所以它们照样被拷进输出目录；
      漏了的症状是「开始代理 / 启动远程管理」当场 FileNotFoundException —— 改包引用时先想这一条。
    -->
    <PackageReference Include="Microsoft.Owin.Host.HttpListener" Version="4.2.3" />
    <PackageReference Include="Microsoft.Owin.Hosting" Version="4.2.3" />
    <PackageReference Include="Microsoft.Owin.StaticFiles" Version="4.2.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Newtonsoft.Json.Bson" Version="1.0.3" />
    <PackageReference Include="Owin" Version="1.0.0" />
    <PackageReference Include="QQWry" Version="1.3.1" />
    <PackageReference Include="Stub.System.Data.SQLite.Core.NetFramework" Version="1.0.119.0" />
    <PackageReference Include="SuperSocket" Version="1.6.6.1" />
    <PackageReference Include="SuperSocket.Engine" Version="1.6.6.1" />
    <!--
      SuperSocket 1.6.6.1 在 nuspec 里依赖 log4net 2.0.3，而 WPE 从来不用它（SuperSocket 的日志由 WpeLogFactory 转给 Operate.DoLog，
      见 CLAUDE.md「SuperSocket 的日志出口必须自己给」）。packages.config 时代它早被删了，这里把它的资产整个排掉，
      免得 PackageReference 顺着依赖又把 log4net.dll 带回输出目录。
      钉的是 3.4.0 而不是 nuspec 里的下限 2.0.3：资产照样一个都不进输出，但依赖图里不再挂着 2.0.3 那两条
      漏洞通告（GHSA-2cwj-8chv-9pp9 / GHSA-4f7c-pmjv-c25w），原先那两句 NuGetAuditSuppress 也就不用了。
      3.4.0 的 .NETFramework4.6.2 组没有任何依赖，不会顺带拉进别的包。
    -->
    <PackageReference Include="log4net" Version="3.4.0" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119.0" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    随程序发布的非托管文件与数据。这些文件本来就在默认 None 通配里，这里只补「拷到输出目录」这一条。
    写成 None 而不是 Content：两者都会经 ProjectReference 传给 WPEHookTest（跑测要它们），None 不会在工程里多出一份重复项。
  -->
  <ItemGroup>
    <None Update="EasyHook32.dll;EasyHook32Svc.exe;EasyHook64.dll;EasyHook64Svc.exe;EasyLoad32.dll;EasyLoad64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x86\SunnyNet.dll;x64\SunnyNet64.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!--
      SQLite.Interop 两份：Stub.System.Data.SQLite.Core.NetFramework 的 targets 也会往 x86\ / x64\ 拷同一对文件
      （字节完全相同，2026-09-11 核过哈希），老式工程时代也是两路并存。留着工程里这一对，是因为包的 build 资产
      不向引用方传递 —— 去掉它们，WPEHookTest 的输出目录里就没有 SQLite.Interop 了。
    -->
    <None Update="x86\SQLite.Interop.dll;x64\SQLite.Interop.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="IPLocation\qqwry.dat">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!--
      WPE 数据文件（.sb / .fp …）在资源管理器里的图标。ClassObject\FileAssociation 启动时把它拷到
      %LOCALAPPDATA%\WPE64\Icons 再注册。它是 wpe.ico 的派生产物：换了主图标要重跑 tools\icons\DataIcon.cs。
    -->
    <None Update="wpe-data.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 远程管理台（手写静态页，零构建）：整个 Web\ 目录照原样发布，新增文件不用再回来改工程 -->
    <None Update="Web\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!--
      设计令牌：<b>直接引前端工程里那个源文件</b>，Link 把它投影成输出目录的 Web\tokens.css。
      管理台与 Vue 界面共用同一份令牌，不是各抄一份（改配色只改那一个文件）。
    -->
    <None Update="WebUI\src\tokens.css">
      <Link>Web\tokens.css</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    前端产物 wwwroot 整目录镜像进输出目录。刻意不用 Content Include（Vite 哈希文件名 +
    求值期展开会漏新文件 / 留死文件）；清理与拷贝在同一个 target 里成对做 ——
    只清不拷的话 .CopyComplete 标记还在，下次构建判定「已是最新」直接跳过，产出一个没有前端的输出目录。
  -->
  <Target Name="StageWwwroot" AfterTargets="Build">
    <ItemGroup>
      <WwwrootFile Include="wwwroot\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)wwwroot" />
    <Copy SourceFiles="@(WwwrootFile)"
          DestinationFiles="@(WwwrootFile->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
