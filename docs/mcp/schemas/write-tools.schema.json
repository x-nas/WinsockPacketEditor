    "wpe_filter_delete": { "input": { "type": "object", "required": ["id", "idempotencyKey"], "properties": { "id": { "type": "string", "format": "uuid" }, "idempotencyKey": { "type": "string", "format": "uuid" } }, "additionalProperties": false }, "output": { "type": "object" } },
