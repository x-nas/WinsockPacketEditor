    "wpe_warehouse_stores_command": { "input": { "type": "object", "required": ["warehouseId", "action", "idempotencyKey"], "properties": { "warehouseId": { "type": "string", "format": "uuid" }, "action": { "type": "string", "enum": ["import", "export", "clear"] }, "idempotencyKey": { "type": "string", "format": "uuid" } }, "additionalProperties": false }, "output": { "type": "object" } },
    "wpe_packet_edit_save": { "input": { "$ref": "#/$defs/packetEditSave" }, "output": { "type": "object" } },
    "wpe_packet_edit_add_to_send": { "input": { "type": "object", "required": ["sendId", "list", "id", "payloadBase64", "idempotencyKey"], "properties": { "sendId": { "type": "string", "format": "uuid" }, "list": { "type": "string", "enum": ["proxy", "packet"] }, "id": { "type": "integer", "minimum": 1 }, "payloadBase64": { "type": "string", "minLength": 1, "maxLength": 1398104 }, "idempotencyKey": { "type": "string", "format": "uuid" } }, "additionalProperties": false }, "output": { "type": "object" } },
    "wpe_start_mode_select": {
      "input": {
        "type": "object",
        "required": ["mode", "idempotencyKey"],
