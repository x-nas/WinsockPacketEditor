  },
  "$defs": {
    "entityWrite": { "type": "object", "required": ["id", "idempotencyKey"], "properties": { "id": { "type": "string", "format": "uuid" }, "idempotencyKey": { "type": "string", "format": "uuid" } }, "additionalProperties": false },
    "sendCollectionAction": { "type": "object", "required": ["sendId", "packetIds", "action", "idempotencyKey"], "properties": { "sendId": { "type": "string", "format": "uuid" }, "packetIds": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "string", "minLength": 1 } }, "action": { "type": "string", "enum": ["top", "up", "down", "bottom", "copy", "delete"] }, "idempotencyKey": { "type": "string", "format": "uuid" } }, "additionalProperties": false },
    "warehouseStoresAction": { "type": "object", "required": ["warehouseId", "storeIds", "action", "idempotencyKey"], "properties": { "warehouseId": { "type": "string", "format": "uuid" }, "storeIds": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "string", "minLength": 1 } }, "action": { "type": "string", "enum": ["top", "up", "down", "bottom", "copy", "export", "delete"] }, "idempotencyKey": { "type": "string", "format": "uuid" } }, "additionalProperties": false },
    "packetEditSave": { "type": "object", "required": ["list", "id", "socket", "payloadBase64", "idempotencyKey"], "properties": { "list": { "type": "string", "enum": ["proxy", "packet"] }, "id": { "type": "integer", "minimum": 1 }, "socket": { "type": "integer" }, "payloadBase64": { "type": "string", "minLength": 1, "maxLength": 1398104 }, "idempotencyKey": { "type": "string", "format": "uuid" } }, "additionalProperties": false },
    "captureAdd": { "type": "object", "required": ["targetId", "packetIds", "idempotencyKey"], "properties": { "targetId": { "type": "string", "format": "uuid" }, "packetIds": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "integer", "minimum": 1 } }, "idempotencyKey": { "type": "string", "format": "uuid" } }, "additionalProperties": false },
    "notApplied": {
      "type": "object",
      "required": ["outcome", "requestHash"],
      "properties": {
        "outcome": { "type": "string", "enum": ["rejected", "expired"] },
